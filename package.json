{
	"name": "@tevm/logger",
	"version": "1.0.0-rc.151",
	"description": "Shared structured logging for TEVM core and bundler packages",
	"keywords": [
		"ethereum",
		"evm",
		"logger",
		"pino",
		"solidity",
		"tevm",
		"typescript",
		"web3"
	],
	"homepage": "https://logger.tevm.sh",
	"bugs": {
		"url": "https://github.com/evmts/tevm-logger/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-logger.git"
	},
	"license": "MIT",
	"contributors": [
		"Will Cory <willcory10@gmail.com>"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/**/*.spec.ts"
	],
	"scripts": {
		"build": "tsup --dts",
		"build:dist": "tsup",
		"build:types": "tsup --dts-only",
		"changeset": "changeset",
		"clean": "rm -rf coverage dist node_modules",
		"docs:build": "pnpm --filter @tevm/logger-site build",
		"docs:dev": "pnpm --filter @tevm/logger-site dev",
		"docs:preview": "pnpm --filter @tevm/logger-site preview",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"generate:docs": "typedoc",
		"lint": "biome check .",
		"lint:package": "publint --strict && attw --pack",
		"release": "pnpm build && changeset publish",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"version-packages": "changeset version"
	},
	"dependencies": {
		"pino": "^10.3.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.31.1",
		"@tevm/tsconfig": "^1.0.0-next.142",
		"@tevm/tsupconfig": "^1.0.0-next.148",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"publint": "^0.3.22",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": "^24.0.0"
	},
	"packageManager": "pnpm@9.15.9"
}
